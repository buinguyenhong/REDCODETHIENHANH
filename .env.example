# ===================================================
# REDCODE HOSPITAL — ENVIRONMENT CONFIGURATION
# ===================================================

# Environment mode: development / production
ENVIRONMENT=development
DEMO_MODE=false
INITIAL_ADMIN_PASSWORD=

# Database connection
# Bắt buộc khi ENVIRONMENT=production. PostgreSQL do IT dựng sẵn; REDCODE chỉ kết nối.
# Định dạng: postgresql+asyncpg://user:password@host:5432/redcode
DATABASE_URL=
# Dev không có PostgreSQL thì dùng SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./redcode.db

# Security & JWT
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Station Monitoring
HEARTBEAT_INTERVAL_SECONDS=5
STATION_OFFLINE_THRESHOLD_SECONDS=15

# n8n Integration (tùy chọn, không thuộc đường báo động cốt lõi)
# Bật/tắt bằng N8N_ENABLED. Tắt thì hệ thống báo động nội bộ chạy bình thường và
# không tạo bản ghi chờ gửi nào. Chỉ gửi khi có báo động mới phát sinh.
N8N_ENABLED=false
N8N_WEBHOOK_URL=
N8N_TIMEOUT_SECONDS=4
N8N_MAX_RETRIES=3

# Server & CORS
ALLOWED_ORIGINS=http://localhost
PORT=8000
HOST=0.0.0.0
