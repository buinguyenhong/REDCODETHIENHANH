# ===================================================
# REDCODE HOSPITAL — ENVIRONMENT CONFIGURATION
# ===================================================

# Environment mode: development / production
ENVIRONMENT=development
DEMO_MODE=false
INITIAL_ADMIN_PASSWORD=

# Database connection
# Note: In production Docker, point to existing PostgreSQL container (e.g., postgresql+asyncpg://postgres:password@postgres_host:5432/redcode)
# For local dev without docker, SQLite async fallback is supported or local Postgres:
DATABASE_URL=
# Leave empty for first-install PostgreSQL setup UI in Docker.
# Fallback SQLite for quick local test if Postgres is not running:
# DATABASE_URL=sqlite+aiosqlite:///./redcode.db

# Security & JWT
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Station Monitoring
HEARTBEAT_INTERVAL_SECONDS=5
STATION_OFFLINE_THRESHOLD_SECONDS=15

# n8n Integration (Optional, asynchronous)
N8N_WEBHOOK_URL=
# n8n is disabled by default; configure in Admin /admin/settings.
N8N_TIMEOUT_SECONDS=5
N8N_MAX_RETRIES=3

# Server & CORS
ALLOWED_ORIGINS=http://localhost
PORT=8000
HOST=0.0.0.0
